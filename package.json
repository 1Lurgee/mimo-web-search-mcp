{
  "name": "mimo-web-search-mcp",
  "version": "2.0.0",
  "description": "MCP Server wrapping Xiaomi MiMo web_search API for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mimo-web-search": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tests/run-all.mjs",
    "test:quick": "node tests/test-code-quality.mjs",
    "test:config": "node tests/test-config.mjs",
    "test:logger": "node tests/test-logger.mjs",
    "test:mcp": "node tests/test-mcp-client.mjs",
    "precommit": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
